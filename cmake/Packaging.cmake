if(NOT TARGET PointyPointer)
  return()
endif()
if(POLICY CMP0177)
  cmake_policy(SET CMP0177 NEW)
endif()
set(notices "${CMAKE_CURRENT_BINARY_DIR}/distribution-licenses")
file(MAKE_DIRECTORY "${notices}")
function(pointy_license source name)
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Missing distribution notice: ${source}")
  endif()
  configure_file("${source}" "${notices}/${name}" COPYONLY)
endfunction()
pointy_license("${sdl_SOURCE_DIR}/LICENSE.txt" SDL.txt)
pointy_license("${sdl_image_SOURCE_DIR}/LICENSE.txt" SDL_image.txt)
pointy_license("${sdl_ttf_SOURCE_DIR}/LICENSE.txt" SDL_ttf.txt)
pointy_license("${freetype_SOURCE_DIR}/docs/FTL.TXT" FreeType.txt)
pointy_license("${harfbuzz_SOURCE_DIR}/COPYING" HarfBuzz.txt)
pointy_license("${harfbuzz_SOURCE_DIR}/src/ms-use/COPYING" HarfBuzz-Microsoft.txt)
pointy_license("${plutosvg_SOURCE_DIR}/LICENSE" PlutoSVG.txt)
pointy_license("${plutovg_SOURCE_DIR}/LICENSE" PlutoVG.txt)
pointy_license("${libpng_SOURCE_DIR}/LICENSE" libpng.txt)
pointy_license("${zlib_SOURCE_DIR}/LICENSE" zlib.txt)
pointy_license("${expat_SOURCE_DIR}/COPYING" Expat.txt)
pointy_license("${yyjson_SOURCE_DIR}/LICENSE" yyjson.txt)
pointy_license("${miniz_SOURCE_DIR}/LICENSE" miniz.txt)
pointy_license("${nuklear_SOURCE_DIR}/LICENSE" Nuklear.txt)
if(APPLE)
  set(data_destination "Yoink.app/Contents/Resources")
else()
  set(data_destination ".")
endif()
install(TARGETS PointyPointer
  RUNTIME DESTINATION . COMPONENT Application
  BUNDLE DESTINATION . COMPONENT Application)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/resources" DESTINATION "${data_destination}" COMPONENT Application)
install(DIRECTORY "${notices}/" DESTINATION "${data_destination}/licenses" COMPONENT Application)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/docs/third-party-notices.md"
  "${PROJECT_SOURCE_DIR}/README.md" DESTINATION "${data_destination}" COMPONENT Application)
install(FILES "${PROJECT_SOURCE_DIR}/docs/project-format.md" "${PROJECT_SOURCE_DIR}/docs/third-party-notices.md"
  DESTINATION "${data_destination}/docs" COMPONENT Application)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/testing" DESTINATION "${data_destination}/docs" COMPONENT Application)
set(CPACK_PACKAGE_NAME Yoink)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_GENERATOR ZIP)
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_COMPONENTS_ALL Application)
set(CPACK_ARCHIVE_APPLICATION_FILE_NAME "Yoink-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
include(CPack)
