# PointyPointer alteration to SDL_image 0891fc30428b518e7d018677bd6fa95c1a50f4c6.
# Alpha canvases default to BLEND; disposal 3 needs exact snapshot/restore copies,
# including transparent pixels. Raw image frames continue to blend onto canvas.
# Retain the upstream copyright/license in the generated source. Never write to
# FetchContent overrides: replace only the target's GIF source with a build copy.
file(READ "${sdl_image_SOURCE_DIR}/src/IMG_gif.c" pp_gif_original)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sdl_image_SOURCE_DIR}/src/IMG_gif.c")
string(REPLACE "\r\n" "\n" pp_gif_original "${pp_gif_original}")
string(SHA256 pp_gif_hash "${pp_gif_original}")
set(pp_gif_expected "d461912e7a29601c634aa5edd6c7ed2204e1f2646efc59285087039bca8c9cc4")
if(NOT pp_gif_hash STREQUAL pp_gif_expected)
  message(FATAL_ERROR "SDL_image GIF source differs from the pinned revision; refusing the disposal patch")
endif()
set(pp_gif_patched "${pp_gif_original}")
foreach(canvas canvas prev_canvas)
  set(pp_gif_anchor "                if (!SDL_FillSurfaceRect(ctx->${canvas}, NULL, 0)) {")
  string(FIND "${pp_gif_patched}" "${pp_gif_anchor}" pp_gif_position)
  if(pp_gif_position LESS 0)
    message(FATAL_ERROR "Missing SDL_image GIF patch anchor for ${canvas}")
  endif()
  set(pp_gif_replacement "                /* PointyPointer: snapshots/restores must copy transparent pixels. */\n                if (!SDL_SetSurfaceBlendMode(ctx->${canvas}, SDL_BLENDMODE_NONE)) {\n                    return SDL_SetError(\"Failed to configure GIF canvas copy mode\");\n                }\n\n${pp_gif_anchor}")
  string(REPLACE "${pp_gif_anchor}" "${pp_gif_replacement}" pp_gif_patched "${pp_gif_patched}")
endforeach()
set(pp_gif_generated "${CMAKE_CURRENT_BINARY_DIR}/patched-sdl-image/IMG_gif.c")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/patched-sdl-image")
file(CONFIGURE OUTPUT "${pp_gif_generated}" CONTENT "${pp_gif_patched}" @ONLY)
get_target_property(pp_image_sources SDL3_image-static SOURCES)
set(pp_image_replaced FALSE)
set(pp_image_patched_sources "")
foreach(source IN LISTS pp_image_sources)
  if(source STREQUAL "src/IMG_gif.c" OR source STREQUAL "${sdl_image_SOURCE_DIR}/src/IMG_gif.c")
    list(APPEND pp_image_patched_sources "${pp_gif_generated}")
    set(pp_image_replaced TRUE)
  else()
    list(APPEND pp_image_patched_sources "${source}")
  endif()
endforeach()
if(NOT pp_image_replaced)
  message(FATAL_ERROR "SDL_image target does not contain the expected GIF source")
endif()
set_property(TARGET SDL3_image-static PROPERTY SOURCES "${pp_image_patched_sources}")
target_include_directories(SDL3_image-static PRIVATE "${sdl_image_SOURCE_DIR}/src")
